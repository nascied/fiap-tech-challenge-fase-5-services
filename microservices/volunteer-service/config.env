# Configuração local/dev para docker-compose. Não usar estes valores em produção.

# App
PORT=8083

# DynamoDB (via LocalStack)
AWS_REGION=us-east-1
AWS_DYNAMODB_TABLE=SolidaryTechVolunteers
AWS_ENDPOINT_URL_DYNAMODB=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Observabilidade (OpenTelemetry). Endpoint aponta pro otel-collector do repo
# fiap-tech-challenge-fase-5-observability (não pro Datadog diretamente) — o
# Collector roteia: traces -> Datadog, métricas -> Prometheus, logs -> Loki.
# Desligado por padrão (TRACES_EXPORTER=none/METRICS_EXPORTER=none) — trocar
# as duas para "otlp" pra habilitar (endpoint só é usado se pelo menos um
# dos dois estiver "otlp").
OTEL_SERVICE_NAME=volunteer-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=none # trocar para "otlp" para habilitar
OTEL_METRICS_EXPORTER=none # trocar para "otlp" para habilitar (alimenta os dashboards SRE/Golden Metrics)
OTEL_LOGS_EXPORTER=none
# Sem isso, a instrumentação WSGI/Flask (opentelemetry-instrumentation==0.48b0)
# emite só a convenção semântica ANTIGA (http.server.duration, em ms) — os
# dashboards SRE (repo observability) consultam a NOVA (http_server_request_
# duration_seconds_count). "http" = só a nova; "http/dup" emitiria as duas.
OTEL_SEMCONV_STABILITY_OPT_IN=http
