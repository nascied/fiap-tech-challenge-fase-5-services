# Configuração local/dev para docker-compose. Não usar estes valores em produção.

# App
PORT=8082
DATABASE_URL=postgres://donation:donation@donation-pg-db:5432/donation_db?sslmode=disable

# Postgres (usado também pelo container donation-pg-db)
POSTGRES_USER=donation
POSTGRES_PASSWORD=donation
POSTGRES_DB=donation_db

# SQS (via LocalStack). Fila criada em localstack/init/init-sqs.sh
AWS_REGION=us-east-1
AWS_SQS_URL=http://localstack:4566/000000000000/solidary-donations
AWS_ENDPOINT_URL_SQS=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Observabilidade (OpenTelemetry). Vazio/ausente desativa traces E métricas
# (no-op — ver initTracing()/initMetrics() em main.go). Endpoint aponta pro
# otel-collector do repo fiap-tech-challenge-fase-5-observability (não pro
# Datadog diretamente) — o Collector roteia: traces -> Datadog, métricas ->
# Prometheus (alimenta os dashboards SRE/Golden Metrics), logs -> Loki.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4318
# A partir do otelhttp v0.62.0 (ver go.mod) o histograma novo (http.server.request.duration,
# é o que os dashboards SRE consultam) passou a ser emitido por padrão, sem depender desta
# variável — v0.54.0 a v0.61.0 tinham a variável mas nunca chegaram a implementar a métrica
# nova de verdade (só as trace attributes), e v0.49.0 nem lia a variável. Hoje esta variável
# só decide se a métrica ANTIGA (http.server.duration) também é emitida em paralelo
# ("http/dup") — como não usamos "http/dup", só a nova é emitida.
OTEL_SEMCONV_STABILITY_OPT_IN=http
